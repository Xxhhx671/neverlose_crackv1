local fireGunAt, doShootMurder, doMurderAllKill, findMurderer, findSheriffOrHero
local isLocalMurderer, isLocalSheriff, isLocalHero

do
    local LP = LocalPlayer

    function findMurderer()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local d = RolesCache[p.Name]
                if d and d.Role == "Murderer" and not d.Dead and not d.Killed then
                    return p
                end
            end
        end
        return nil
    end

    function findSheriffOrHero()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local d = RolesCache[p.Name]
                if d and d.Role == "Sheriff" and not d.Dead and not d.Killed then
                    return p, "Sheriff"
                end
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP then
                local d = RolesCache[p.Name]
                if d and d.Role == "Hero" and not d.Dead and not d.Killed then
                    return p, "Hero"
                end
            end
        end
        return nil, nil
    end

    function isLocalMurderer()
        local d = RolesCache[LP.Name]
        return d and d.Role == "Murderer"
    end
    function isLocalSheriff()
        local d = RolesCache[LP.Name]
        return d and d.Role == "Sheriff"
    end
    function isLocalHero()
        local d = RolesCache[LP.Name]
        return d and d.Role == "Hero"
    end

    local BULLET_SPEED = 250
    local PING_MULT = 1.0
    local HEAD_OFFSET = 0.5

    local function getGunHandle()
        local char = LP.Character
        if not char then return nil end
        local gun = char:FindFirstChild("Gun")
            or (LP.Backpack and LP.Backpack:FindFirstChild("Gun"))
        if not gun then return nil end
        return gun:FindFirstChild("Handle"), gun
    end

    local function getTargetPart(player)
        if not player or not player.Character then return nil end
        local char = player.Character
        return char:FindFirstChild("Head")
            or char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("HumanoidRootPart")
    end

    local function getMuzzlePosition()
        local handle = getGunHandle()
        if handle then return handle.Position end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then return hrp.Position + Vector3.new(0, 1.5, 0) end
        return nil
    end

    local function predictTargetPosition(target)
        if not target or not target.Character then return nil end
        local targetPart = getTargetPart(target)
        if not targetPart then return nil end

        local targetHum = target.Character:FindFirstChildOfClass("Humanoid")
        local muzzlePos = getMuzzlePosition()
        if not muzzlePos then
            return targetPart.Position + Vector3.new(0, HEAD_OFFSET, 0)
        end

        local targetPos = targetPart.Position + Vector3.new(0, HEAD_OFFSET, 0)
        local distance = (targetPos - muzzlePos).Magnitude
        local ping = LP:GetNetworkPing() * PING_MULT
        local t = distance / BULLET_SPEED + ping

        local vel = targetPart.AssemblyLinearVelocity or Vector3.new(0, 0, 0)

        local inAir = false
        if targetHum then
            local ok, state = pcall(function() return targetHum:GetState() end)
            if ok then
                inAir = (state == Enum.HumanoidStateType.Freefall
                      or state == Enum.HumanoidStateType.Jumping)
            end
        end

        if inAir then
            return targetPos + vel * t - Vector3.new(0, 0.5 * workspace.Gravity * t * t, 0)
        else
            return targetPos + Vector3.new(vel.X * t, vel.Y * t * 0.3, vel.Z * t)
        end
    end

    function fireGunAt(target)
        local handle, gun = getGunHandle()
        if not gun then return false, "Нет Gun." end
        local char = LP.Character
        if not char then return false, "Нет персонажа." end

        if gun.Parent ~= char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(gun) end
            task.wait(0.08)
        end

        local muzzlePos = getMuzzlePosition()
        if not muzzlePos then return false, "Нет позиции пушки." end

        local aimPos = predictTargetPosition(target)
        if not aimPos then return false, "Нет позиции цели." end

        local shootRemote = gun:FindFirstChild("Shoot")
            or (gun:FindFirstChild("Events") and gun.Events:FindFirstChild("Shoot"))
        if not shootRemote then
            pcall(function() gun:Activate() end)
            return true, "Activated (no remote)"
        end

        local originCF = CFrame.new(muzzlePos, aimPos)
        local targetCF = CFrame.new(aimPos)

        pcall(function()
            shootRemote:FireServer(originCF, targetCF)
        end)
        return true, "Fired"
    end

    function doShootMurder()
        if not isLocalSheriff() and not isLocalHero() then
            return false, "Ты не Sheriff/Hero."
        end
        local murderer = findMurderer()
        if not murderer then return false, "Murderer не найден." end
        return fireGunAt(murderer)
    end

    function doMurderAllKill()
        if not isLocalMurderer() then return false, "Ты не Murderer." end
        local char = LP.Character
        if not char then return false, "Нет персонажа." end

        local knife = char:FindFirstChild("Knife")
        if not knife and LP.Backpack then
            knife = LP.Backpack:FindFirstChild("Knife")
        end
        if not knife then return false, "У тебя нет ножа." end

        if knife.Parent ~= char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:EquipTool(knife) end
            task.wait(0.1)
        end

        local handle = knife:FindFirstChild("Handle")
        if not handle then return false, "У ножа нет Handle." end

        local knifeServer = knife:FindFirstChild("KnifeServer")
        local stab = knife:FindFirstChild("Stab")

        local killed = 0
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local pHrp = p.Character:FindFirstChild("HumanoidRootPart")
                local pHum = p.Character:FindFirstChildOfClass("Humanoid")
                if pHrp and pHum and pHum.Health > 0 then
                    pcall(function()
                        if knifeServer then
                            knife:Activate()
                        elseif stab and stab:IsA("RemoteEvent") then
                            stab:FireServer("Slash")
                        else
                            knife:Activate()
                        end
                        touch(handle, pHrp, 0)
                        task.wait()
                        touch(handle, pHrp, 1)
                    end)
                    killed = killed + 1
                    task.wait(0.05)
                end
            end
        end
        return true, "Killed " .. killed .. " players"
    end
end

