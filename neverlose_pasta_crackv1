local isOpen = true
local animating = false

local function closeUI()
    if animating or not isOpen then return end
    animating = true
    isOpen = false
    local duration = 0.35
    local ip = ToggleButton.AbsolutePosition
    local isz = ToggleButton.AbsoluteSize
    local cx = ip.X + isz.X/2
    local cy = ip.Y + isz.Y/2
    local t = TweenService:Create(MainFrame, TweenInfo.new(duration, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, cx, 0, cy),
        BackgroundTransparency = 1
    })
    t:Play()
    t.Completed:Connect(function()
        MainFrame.Visible = false
        animating = false
    end)
end

local function openUI()
    if animating or isOpen then return end
    animating = true
    isOpen = true
    MainFrame.Visible = true
    MainFrame.Size = UDim2.new(0, 0, 0, 0)
    MainFrame.BackgroundTransparency = 1
    local t = TweenService:Create(MainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = getFinalSize(),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundTransparency = 0
    })
    t:Play()
    t.Completed:Connect(function() animating = false end)
end

ToggleButton.MouseButton1Click:Connect(function()
    if isOpen then closeUI() else openUI() end
end)

local swipeState = {x = 0, t = 0, active = false}
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.Touch
       and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    swipeState.x = input.Position.X
    swipeState.t = tick()
    swipeState.active = true
end)
MainFrame.InputEnded:Connect(function(input)
    if not swipeState.active then return end
    swipeState.active = false
    if input.UserInputType ~= Enum.UserInputType.Touch
       and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
    local dx = input.Position.X - swipeState.x
    local dt = tick() - swipeState.t
    if math.abs(dx) >= 60 or math.abs(dx) / math.max(dt, 0.01) > 500 then
        if dx < 0 then closeUI() elseif dx > 0 then openUI() end
    end
end)

if not IS_MOBILE then
    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == Enum.KeyCode.B then
            if isOpen then closeUI() else openUI() end
        end
    end)
end

