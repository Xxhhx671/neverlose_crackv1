-- ============================================================
-- [SAFE HELPERS]
-- ============================================================
local function safe(fn, ...)
    local args = {...}
    local ok, err = pcall(fn, table.unpack(args))
    if not ok then
        warn("[NeverLose]", err)
    end
    return ok, err
end

local function getHui()
    if gethui then
        local ok, r = pcall(gethui)
        if ok and r then return r end
    end
    local ok, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok and cg then return cg end
    return game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
end

local function newGui(name)
    local g = Instance.new("ScreenGui")
    g.Name = name
    g.ResetOnSpawn = false
    g.IgnoreGuiInset = true
    pcall(function() g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling end)
    pcall(function() g.DisplayOrder = 999 end)
    local ok = pcall(function() g.Parent = getHui() end)
    if not ok then
        pcall(function()
            g.Parent = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
        end)
    end
    return g
end

local function touch(p1, p2, state)
    if firetouchinterest then
        pcall(function() firetouchinterest(p1, p2, state) end)
    elseif firetouchinterest_old then
        pcall(function() firetouchinterest_old(p1, p2, state) end)
    end
end

