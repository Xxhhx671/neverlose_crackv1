    local FlingActive, FlingTargetPlayer = false, nil
    getgenv().OldPos = nil
    getgenv().FPDH = workspace.FallenPartsDestroyHeight

    local function SkidFling(TargetPlayer)
        local Character = LocalPlayer.Character
        local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
        local RootPart = Humanoid and Humanoid.RootPart
        local TCharacter = TargetPlayer and TargetPlayer.Character
        if not TCharacter then return end

        local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
        local TRootPart = THumanoid and THumanoid.RootPart
        local THead = TCharacter:FindFirstChild("Head")

        if Character and Humanoid and RootPart then
            if RootPart.Velocity.Magnitude < 50 then
                getgenv().OldPos = RootPart.CFrame
            end
            if THumanoid and THumanoid.Sit then return end
            if THead then workspace.CurrentCamera.CameraSubject = THead end

            local FPos = function(BasePart, Pos, Ang)
                RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
                Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
                RootPart.Velocity = Vector3.new(1e6, 1e7, 1e6)
                RootPart.RotVelocity = Vector3.new(1e6, 1e6, 1e6)
            end

            local SFBasePart = function(BasePart)
                local t0 = tick()
                local Angle = 0
                repeat
                    if RootPart and THumanoid then
                        Angle = Angle + 100
                        FPos(BasePart, CFrame.new(0, 1.5, 0), CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, 1.5, 0), CFrame.Angles(math.rad(90), 0, 0))
                        task.wait()
                        FPos(BasePart, CFrame.new(0, -1.5, 0), CFrame.Angles(0, 0, 0))
                        task.wait()
                    end
                until tick() - t0 > 3 or not FlingActive
            end

            pcall(function() workspace.FallenPartsDestroyHeight = 0/0 end)

            local BV = Instance.new("BodyVelocity")
            BV.Parent = RootPart
            BV.Velocity = Vector3.new(0, 0, 0)
            BV.MaxForce = Vector3.new(1e6, 1e6, 1e6)

            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

            if TRootPart then SFBasePart(TRootPart)
            elseif THead then SFBasePart(THead) end

            BV:Destroy()
            Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
            workspace.CurrentCamera.CameraSubject = Humanoid

            if getgenv().OldPos then
                pcall(function()
                    RootPart.CFrame = getgenv().OldPos * CFrame.new(0, .5, 0)
                    Character:SetPrimaryPartCFrame(getgenv().OldPos * CFrame.new(0, .5, 0))
                    Humanoid:ChangeState("GettingUp")
                end)
                pcall(function() workspace.FallenPartsDestroyHeight = getgenv().FPDH end)
            end
        end
    end

    local function startFling(targetPlayer)
        if FlingActive then return false, "Уже" end
        if not targetPlayer or not targetPlayer.Character then return false, "Нет цели" end
        FlingActive = true
        FlingTargetPlayer = targetPlayer
        task.spawn(function()
            while FlingActive and FlingTargetPlayer == targetPlayer do
                if targetPlayer.Parent and targetPlayer.Character then
                    local th = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if th and th.Health > 0 then
                        pcall(SkidFling, targetPlayer)
                    else
                        FlingActive = false
                        break
                    end
                else
                    FlingActive = false
                    break
                end
                task.wait(0.2)
            end
        end)
        return true
    end

    local function stopFling()
        FlingActive = false
        FlingTargetPlayer = nil
        pcall(function() workspace.FallenPartsDestroyHeight = getgenv().FPDH end)
    end

    makeButton(Inner, 10, "FLING MURDER", C.danger, function(btn)
        if FlingActive then
            stopFling()
            btn.BackgroundColor3 = C.danger
            btn.Text = "FLING MURDER"
            Notify("Fling остановлен", 2, "warn")
            return
        end
        local m = findMurderer()
        if not m then Notify("Murderer не найден", 2, "error"); return end
        local ok = startFling(m)
        if ok then
            btn.BackgroundColor3 = C.success
            btn.Text = "STOP FLING"
            Notify("Fling → " .. m.Name, 2, "success")
        end
    end)

    makeButton(Inner, 11, "FLING SHERIFF / HERO", C.danger, function(btn)
        if FlingActive then
            stopFling()
            btn.BackgroundColor3 = C.danger
            btn.Text = "FLING SHERIFF / HERO"
            Notify("Fling остановлен", 2, "warn")
            return
        end
        local target = findSheriffOrHero()
        if not target then Notify("Sheriff/Hero не найден", 2, "error"); return end
        local ok = startFling(target)
        if ok then
            btn.BackgroundColor3 = C.success
            btn.Text = "STOP FLING"
            Notify("Fling → " .. target.Name, 2, "success")
        end
    end)
end)

