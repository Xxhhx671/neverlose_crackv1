safe(function()
    local Inner = GetTabInner(TabPanels["Weapon"])
    local WeaponState = { AutoGrab = false }

    local function findDroppedGun()
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "GunDrop" then
                if obj:IsA("BasePart") then return obj
                elseif obj:IsA("Model") then
                    local bp = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                    if bp then return bp end
                end
            end
        end
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("Tool") and obj.Name == "Gun" then
                local handle = obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart", true)
                if handle then return handle end
            end
        end
        return nil
    end

    local function pickupGun(handle)
        local char = LocalPlayer.Character
        if not char then return false end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp or not handle or not handle.Parent then return false end
        if firetouchinterest or firetouchinterest_old then
            touch(hrp, handle, 0)
            task.wait(0.05)
            touch(hrp, handle, 1)
        else
            pcall(function() hrp.CFrame = handle.CFrame + Vector3.new(0, 2, 0) end)
        end
        return true
    end

    local autoGrabRunning = false
    local function startAutoGrab()
        if autoGrabRunning then return end
        autoGrabRunning = true
        task.spawn(function()
            while autoGrabRunning and WeaponState.AutoGrab do
                task.wait(0.35)
                local data = RolesCache[LocalPlayer.Name]
                local role = data and data.Role or "Unknown"
                if role ~= "Murderer" then
                    local char = LocalPlayer.Character
                    if char then
                        local alreadyHas = char:FindFirstChild("Gun")
                            or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
                        if alreadyHas then
                            local murderer = findMurderer()
                            if murderer then fireGunAt(murderer) end
                            task.wait(0.5)
                        else
                            local handle = findDroppedGun()
                            if handle and handle.Parent then
                                local hrp = char:FindFirstChild("HumanoidRootPart")
                                if hrp then
                                    local distance = (hrp.Position - handle.Position).Magnitude
                                    if distance > 6 then
                                        pcall(function() hrp.CFrame = handle.CFrame + Vector3.new(0, 3, 0) end)
                                        task.wait(0.15)
                                    end
                                    pickupGun(handle)
                                    task.wait(0.2)
                                    local picked = char:FindFirstChild("Gun")
                                        or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChild("Gun"))
                                    if picked then
                                        task.wait(0.08)
                                        local murderer = findMurderer()
                                        if murderer then fireGunAt(murderer) end
                                        task.wait(0.4)
                                    end
                                end
                            end
                        end
                    end
                end
            end
            autoGrabRunning = false
        end)
    end

    local function stopAutoGrab() autoGrabRunning = false end

    makeToggle(Inner, 1, "AutoGrab Weapon", false, function(v)
        WeaponState.AutoGrab = v
        if v then
            Notify("AutoGrab запущен", 2, "load")
            startAutoGrab()
        else
            Notify("AutoGrab остановлен", 2, "warn")
            stopAutoGrab()
        end
    end)
end)

