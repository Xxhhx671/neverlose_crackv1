            task.delay(0.08, function()
                TweenService:Create(btn, TweenInfo.new(0.15, Enum.EasingStyle.Back), {
                    Size = origSize
                }):Play()
            end)
        end)
        if callback then pcall(callback, btn) end
    end)
    return btn
