local Themes = {
    Cyan   = { accent = Color3.fromRGB(0,170,255),   accentDark = Color3.fromRGB(0,120,200),  accentGlow = Color3.fromRGB(60,200,255) },
    Purple = { accent = Color3.fromRGB(160,80,255),  accentDark = Color3.fromRGB(110,50,200), accentGlow = Color3.fromRGB(200,140,255) },
    Red    = { accent = Color3.fromRGB(230,60,60),   accentDark = Color3.fromRGB(180,30,30),  accentGlow = Color3.fromRGB(255,120,120) },
    Green  = { accent = Color3.fromRGB(60,220,120),  accentDark = Color3.fromRGB(30,170,80),  accentGlow = Color3.fromRGB(120,255,170) },
    Gold   = { accent = Color3.fromRGB(255,200,50),  accentDark = Color3.fromRGB(200,150,20), accentGlow = Color3.fromRGB(255,230,130) },
    Pink   = { accent = Color3.fromRGB(255,90,180),  accentDark = Color3.fromRGB(200,50,140), accentGlow = Color3.fromRGB(255,150,210) },
}

local CurrentThemeName = "Cyan"
local ThemedElements = {}

local function registerThemed(inst, property, colorKey)
    if inst then
        table.insert(ThemedElements, { inst = inst, prop = property, key = colorKey })
    end
end

local function applyTheme(name)
    local t = Themes[name]
    if not t then return end
    CurrentThemeName = name
    C.accent     = t.accent
    C.accentDark = t.accentDark
    C.accentGlow = t.accentGlow
    for _, item in ipairs(ThemedElements) do
        safe(function()
            if item.inst and item.inst.Parent then
                item.inst[item.prop] = t[item.key]
            end
        end)
    end
    Notify("Тема изменена: " .. name, 2, "success")
end

-- ============================================================
-- [LOG CAPTURE]
-- ============================================================
local LogsBuffer = {}
local OldPrint = print
local OldWarn  = warn

local function addLog(prefix, ...)
    local parts = {}
    for i = 1, select("#", ...) do
        table.insert(parts, tostring(select(i, ...)))
    end
    local line = string.format("[%s] [%s] %s", os.date("%H:%M:%S"), prefix, table.concat(parts, " "))
    table.insert(LogsBuffer, line)
    if #LogsBuffer > 300 then table.remove(LogsBuffer, 1) end
end

getgenv().print = function(...) addLog("PRINT", ...); OldPrint(...) end
getgenv().warn  = function(...) addLog("WARN", ...);  OldWarn(...)  end

local function copyToClipboard(text)
    if setclipboard then safe(function() setclipboard(text) end); return true end
    if toclipboard then safe(function() toclipboard(text) end); return true end
    if Clipboard and Clipboard.set then safe(function() Clipboard.set(text) end); return true end
    return false
end

